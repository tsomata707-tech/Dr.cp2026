rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collaborative research groups real-time rooms
    match /groupRooms/{groupId} {
      allow read, write: if true;
    }
    // Student individual progress and level completions
    match /studentsProgress/{username} {
      allow read, write: if true;
    }
    // Student real logins and sessions audit
    match /studentsLoginsAudit/{username} {
      allow read, write: if true;
    }
    // Global test question banks, level configurations, and site settings
    match /globalSettings/{settingId} {
      allow read, write: if true;
    }
    // Admin settings and audit logs
    match /adminSettings/{settingId} {
      allow read, write: if true;
    }
    match /activityLogs/{logId} {
      allow read, write: if true;
    }
    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
